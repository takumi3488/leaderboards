<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title data-i18n="title">Model comparison — score and estimated no-cache API and subscription rates</title>
  <meta name="description" content="Compare benchmark scores and estimated no-cache API and subscription rates in USD per 1M total tokens across Terminal-Bench, FrontierCode, and Terminal-Bench Science.">
