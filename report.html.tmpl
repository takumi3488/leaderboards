        const benchmarkIndex = (REPORT.benchmarks || []).findIndex((benchmark) => benchmark.id === params.get('benchmark'));
        if (benchmarkIndex >= 0) benchmarkSelect.value = String(benchmarkIndex);
        document.querySelectorAll('input[name="cost-mode"]').forEach((input) => { input.checked = input.value === mode; });
        document.querySelectorAll('input[name="cost-basis"]').forEach((input) => { input.checked = input.value === costBasis; });
        document.querySelectorAll('input[name="axis-scale"]').forEach((input) => { input.checked = input.value === axisScale; });

        modelEnabled.clear();
        subscriptionEnabled.clear();
        const subscriptionNames = new Set();
        (REPORT.subscriptions || []).forEach((subscription) => {
          subscriptionNames.add(subscription.name);
          subscriptionEnabled.set(subscription.name, true);
        });
        params.getAll('disabled-plan').forEach((name) => {
          if (subscriptionNames.has(name)) subscriptionEnabled.set(name, false);
