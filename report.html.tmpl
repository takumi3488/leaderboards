        });
      }
      function writeURLState() {
        const url = new URL(window.location.href);
        const params = url.searchParams;
        ['benchmark', 'cost-mode', 'cost-basis', 'axis-scale', 'disabled-plan', 'model-on', 'model-off'].forEach((key) => params.delete(key));
        const benchmark = activeBenchmark();
        params.set('benchmark', text(benchmark && benchmark.id));
        params.set('cost-mode', mode);
        params.set('cost-basis', costBasis);
        params.set('axis-scale', axisScale);
        (REPORT.subscriptions || []).forEach((subscription) => {
          if (subscriptionEnabled.get(subscription.name) === false) params.append('disabled-plan', subscription.name);
        });
        modelEnabled.forEach((enabled, key) => params.append(enabled ? 'model-on' : 'model-off', key));
        if (url.href !== window.location.href) window.history.pushState(null, '', url);
      }
      function restoreFromURL() {
