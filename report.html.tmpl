        }
      };
      const t = (key, ...args) => {
        const value = messages[language][key];
        return typeof value === 'function' ? value(...args) : value;
      };
      function applyLanguage() {
        document.documentElement.lang = language;
        document.querySelectorAll('[data-i18n]').forEach((element) => {
          element.textContent = t(element.dataset.i18n);
        });
        document.querySelectorAll('[data-i18n-aria-label]').forEach((element) => {
          element.setAttribute('aria-label', t(element.dataset.i18nAriaLabel));
        });
      }
      applyLanguage();
  </script>
  <script src="https://cdn.jsdelivr.net/npm/echarts@5.6.0/dist/echarts.min.js" integrity="sha384-pPi0zxBAoDu6+JXW/C68UZLvBUUtU+7zonhif43rqj7pxsGyqyqzcian2Rj37Rss" crossorigin="anonymous"></script>
  <script>
    (() => {
      'use strict';
      const REPORT = JSON.parse(document.getElementById('report-data').textContent);
      const $ = (id) => document.getElementById(id);
      const palette = ['#2454a6', '#b34c38', '#2f826d', '#8c5e9f', '#b27618', '#277d9a', '#b44778', '#587a42', '#6e66a8', '#a45e33', '#3b70bb', '#49727b'];
      const usdFormatter = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumSignificantDigits: 4 });
      const axisUSDFormatter = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumSignificantDigits: 3 });
      const effortOrder = new Map(['none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max'].map((effort, index) => [effort, index]));
      let mode = 'subscription';
      let narrowPlot = window.matchMedia('(max-width: 600px)').matches;
      let axisScale = 'log';
      let chart = null;
      const modelEnabled = new Map(); // explicit user choices only; see isModelEnabled
      const subscriptionEnabled = new Map((REPORT.subscriptions || []).map((subscription) => [subscription.name, true]));
      const benchmarkSelect = $('benchmark-select');

      function text(value) { return value == null ? '' : String(value); }
      function normalizeEffort(value) { return text(value).toLowerCase().replace(/[^a-z0-9]/g, ''); }
      function compareEffortRows(a, b) {
        const aEffort = text(a.point.effort);
        const bEffort = text(b.point.effort);
        const aRank = effortOrder.get(normalizeEffort(aEffort)) ?? -1;
        const bRank = effortOrder.get(normalizeEffort(bEffort)) ?? -1;
        if (aRank !== bRank) {
          if (aRank < 0) return 1;
          if (bRank < 0) return -1;
          return aRank - bRank;
        }
        return a.cost - b.cost ||
          aEffort.localeCompare(bEffort, undefined, { numeric: true, sensitivity: 'base' }) ||
          Number(a.point.score) - Number(b.point.score) ||
          text(a.point.id).localeCompare(text(b.point.id));
      }
      function formatDate(value) {
        const raw = text(value);
        if (!raw) return t('unrecorded');
        const dateOnly = /^\d{4}-\d{2}-\d{2}$/.test(raw);
        const date = new Date(dateOnly ? `${raw}T00:00:00Z` : raw);
        if (Number.isNaN(date.getTime())) return raw;
        if (dateOnly) {
          return new Intl.DateTimeFormat(locale, {
            year: 'numeric', month: language === 'ja' ? '2-digit' : 'short',
            day: language === 'ja' ? '2-digit' : 'numeric', timeZone: 'UTC'
          }).format(date);
        }
        const parts = Object.fromEntries(new Intl.DateTimeFormat(locale, {
          year: 'numeric', month: language === 'ja' ? '2-digit' : 'short',
          day: language === 'ja' ? '2-digit' : 'numeric', hour: 'numeric', minute: '2-digit',
          timeZone, timeZoneName: 'short'
        }).formatToParts(date).map((part) => [part.type, part.value]));
        return language === 'ja'
          ? `${parts.year}/${parts.month}/${parts.day} ${parts.hour}:${parts.minute} ${parts.timeZoneName}`
          : `${parts.month} ${parts.day}, ${parts.year}, ${parts.hour}:${parts.minute} ${parts.dayPeriod} ${parts.timeZoneName}`;
      }
      function formatUSD(value) {
        const amount = Number(value);
        if (!Number.isFinite(amount)) return t('unavailable');
        return amount === 0 ? '$0.00' : usdFormatter.format(amount);
      }
      function formatAxisUSD(value) {
        const amount = Number(value);
        if (!Number.isFinite(amount)) return t('unavailable');
        return amount === 0 ? '$0.00' : axisUSDFormatter.format(amount);
      }
      function formatScore(value) {
        return new Intl.NumberFormat(locale, { maximumFractionDigits: 2 }).format(Number(value));
      }
      function formatRate(value) {
        return new Intl.NumberFormat(locale, { maximumSignificantDigits: 4 }).format(value);
      }
      function safeURL(value) {
        try {
          const url = new URL(text(value));
          return url.protocol === 'http:' || url.protocol === 'https:' ? url.href : '';
        } catch (_) { return ''; }
      }
      function anchor(label, url) {
        const a = document.createElement('a');
        a.textContent = label;
        a.href = url;
        a.rel = 'noreferrer';
        a.target = '_blank';
        return a;
      }
      function makeCell(value, className) {
        const cell = document.createElement('td');
        if (className) cell.className = className;
        cell.textContent = text(value);
        return cell;
      }
      function activeBenchmark() {
        return REPORT.benchmarks && REPORT.benchmarks[Number(benchmarkSelect.value)] || null;
      }
      function initBenchmarks() {
        const benchmarks = REPORT.benchmarks || [];
        benchmarkSelect.replaceChildren();
        benchmarks.forEach((benchmark, index) => {
          const option = document.createElement('option');
          option.value = String(index);
          option.textContent = benchmark.title || benchmark.id || t('noBenchmark', index + 1);
          benchmarkSelect.append(option);
        });
        benchmarkSelect.disabled = benchmarks.length === 0;
        benchmarkSelect.value = benchmarks.length ? '0' : '';
      }
      function renderDates() {
        $('generated-at').textContent = formatDate(REPORT.generatedAt);
        $('subscription-updated').textContent = formatDate(REPORT.subscriptionUpdated);
      }
      function renderEnabledPlanCount() {
        const names = new Set((REPORT.subscriptions || []).map((subscription) => subscription.name));
        const enabled = [...names].filter((name) => subscriptionEnabled.get(name) !== false).length;
        $('enabled-plan-count').textContent = t('enabledPlans', enabled, names.size);
      }
      function renderSubscriptionPanel() {
        const panel = $('subscription-panel');
        panel.hidden = mode !== 'subscription';
        $('fallback-legend').hidden = mode !== 'subscription';
        renderEnabledPlanCount();
        const list = $('subscription-list');
        list.replaceChildren();
        const vendors = new Map();
        (REPORT.subscriptions || []).forEach((subscription) => {
          const vendor = text(subscription.vendor) || t('dataSource');
          if (!vendors.has(vendor)) vendors.set(vendor, []);
          vendors.get(vendor).push(subscription);
        });
        [...vendors.entries()].sort(([left], [right]) => left.localeCompare(right)).forEach(([vendor, plans]) => {
          const group = document.createElement('div');
          group.className = 'vendor-group';
          const vendorLabel = document.createElement('label');
          vendorLabel.className = 'vendor-option';
          const vendorCheckbox = document.createElement('input');
          vendorCheckbox.type = 'checkbox';
          vendorCheckbox.setAttribute('aria-label', t('toggleVendor', vendor));
          const names = [...new Set(plans.map((plan) => plan.name))];
          const enabledNames = names.filter((name) => subscriptionEnabled.get(name) !== false).length;
          vendorCheckbox.checked = enabledNames === names.length;
          vendorCheckbox.indeterminate = enabledNames > 0 && enabledNames < names.length;
          vendorCheckbox.addEventListener('change', () => {
            names.forEach((name) => subscriptionEnabled.set(name, vendorCheckbox.checked));
            renderSubscriptionPanel();
            renderModelLegend();
            renderViews();
          });
          const vendorName = document.createElement('span');
          vendorName.textContent = vendor;
          vendorLabel.append(vendorCheckbox, vendorName);
          group.append(vendorLabel);

          const planList = document.createElement('div');
          planList.className = 'vendor-plans';
          plans.sort((left, right) => Number(left.monthlyUSD) - Number(right.monthlyUSD) ||
            text(left.name).localeCompare(text(right.name))).forEach((subscription) => {
            const label = document.createElement('label');
            label.className = 'sub-option';
            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.checked = subscriptionEnabled.get(subscription.name) !== false;
            checkbox.addEventListener('change', () => {
              subscriptionEnabled.set(subscription.name, checkbox.checked);
              renderSubscriptionPanel();
              renderModelLegend();
              renderViews();
            });
            const content = document.createElement('span');
            content.className = 'sub-option-text';
            const name = document.createElement('span');
            name.className = 'sub-option-name';
            name.textContent = text(subscription.name);
            const monthly = document.createElement('span');
            monthly.className = 'sub-option-meta money';
            monthly.textContent = t('monthlyPrice', formatUSD(subscription.monthlyUSD));
            content.append(name, monthly);
            label.append(checkbox, content);
            planList.append(label);
          });
          group.append(planList);
          list.append(group);
        });
      }
      function renderDefinitions() {
        const benchmark = activeBenchmark();
        $('table-score-heading').textContent = benchmark && benchmark.scoreLabel ? `${t('scoreHeader')} (${benchmark.scoreLabel})` : t('scoreHeader');
        const definition = $('benchmark-definition');
        if (!benchmark) {
          definition.textContent = t('noBenchmarkData');
        } else {
          const details = [];
          if (benchmark.scoreLabel) details.push(t('scoreDefinition', benchmark.scoreLabel));
          if (benchmark.costNote) details.push(t('costDefinition', benchmark.costNote));
          definition.textContent = details.length ? t('definitionDetails', details) : t('defaultDefinition');
        }
        const linkRow = $('benchmark-link-row');
        linkRow.replaceChildren();
        if (benchmark && safeURL(benchmark.url)) {
          linkRow.append(document.createTextNode(t('benchmarkLink')), anchor(benchmark.title || benchmark.id || t('sourceData'), safeURL(benchmark.url)));
        }
      }
      function renderSources() {
        const list = $('source-list');
        list.replaceChildren();
        (REPORT.sources || []).forEach((source) => {
          const li = document.createElement('li');
          const url = safeURL(source.url);
          if (url) li.append(anchor(source.name || source.file || url, url));
          else li.append(document.createTextNode(source.name || source.file || t('dataSource')));
          if (source.fetchedAt) {
            const fetched = document.createElement('span');
            fetched.className = 'source-date';
            fetched.textContent = t('retrieved', formatDate(source.fetchedAt));
            li.append(fetched);
          }
          list.append(li);
        });
        if (!list.children.length) {
          const li = document.createElement('li');
          li.textContent = t('sourcesUnavailable');
          list.append(li);
        }
      }
      function modelColor(model, points) {
        for (const row of points) {
          const color = text(row.color);
          if (row.model === model && /^#[0-9a-f]{3}(?:[0-9a-f]{3}|[0-9a-f]{5})?$/i.test(color)) return color;
        }
        let hash = 0;
        for (const char of model) hash = (hash * 31 + char.codePointAt(0)) | 0;
        return palette[(hash >>> 0) % palette.length];
      }
      function renderModelLegend() {
        const list = $('model-list');
        list.replaceChildren();
        const benchmark = activeBenchmark();
        if (!benchmark || !benchmark.points || !benchmark.points.length) {
          const empty = document.createElement('p');
          empty.className = 'muted';
          empty.textContent = t('noModelData');
          list.append(empty);
          return;
        }
        const models = new Map();
        benchmark.points.forEach((point) => { if (!models.has(text(point.model))) models.set(text(point.model), modelKey(point)); });
        [...models.keys()].sort((a, b) => a.localeCompare(b)).forEach((model) => {
          const key = models.get(model);
          const label = document.createElement('label');
          label.className = 'model-option';
          const checkbox = document.createElement('input');
          checkbox.type = 'checkbox';
          checkbox.checked = isModelEnabled(benchmark, key);
          checkbox.addEventListener('change', () => {
            modelEnabled.set(key, checkbox.checked);
            renderViews();
          });
          const swatch = document.createElement('span');
          swatch.className = 'swatch';
          swatch.style.color = modelColor(model, benchmark.points);
          const name = document.createElement('span');
          name.textContent = model;
          label.append(checkbox, swatch, name);
          list.append(label);
        });
      }
      // Explicit choices are keyed by canonical model, so they carry across benchmarks.
      function modelKey(point) { return text(point.modelKey); }
      // In subscription mode, models without an enabled plan start unchecked.
      function isModelEnabled(benchmark, key) {
        const choice = modelEnabled.get(key);
        if (choice !== undefined) return choice;
        return mode !== 'subscription' || benchmark.points.some((point) => modelKey(point) === key && chosenOffer(point) !== null);
      }
      function chosenOffer(point) {
        if (mode !== 'subscription') return null;
        return (point.offers || []).find((offer) => subscriptionEnabled.get(offer.plan) !== false) || null;
      }
      function rowsForBenchmark() {
        const benchmark = activeBenchmark();
        if (!benchmark || !benchmark.points) return [];
        return benchmark.points.filter((point) => isModelEnabled(benchmark, modelKey(point))).map((point) => {
          const offer = chosenOffer(point);
          const matched = offer !== null;
          return {
            point,
            cost: matched ? Number(offer.cost) : Number(point.apiCost),
            offer: matched ? offer : null,
            fallback: mode === 'subscription' && !matched
          };
        });
      }
      function basisText(row) {
        if (row.offer) return t('matchedPlanBasis', text(row.offer.plan), formatRate(row.offer.usdPerMTok), text(row.offer.confidence));
        return row.fallback ? t('apiFallback') : t('apiMode');
      }
      function renderTable() {
        const body = $('results-body');
        body.replaceChildren();
        const rows = rowsForBenchmark().sort((a, b) => Number(b.point.score) - Number(a.point.score) || text(a.point.model).localeCompare(text(b.point.model)) || text(a.point.effort).localeCompare(text(b.point.effort), undefined, { numeric: true }) || text(a.point.agent).localeCompare(text(b.point.agent)));
        if (!rows.length) {
          const tr = document.createElement('tr');
          const td = document.createElement('td');
          td.colSpan = 7;
          td.className = 'muted';
          td.textContent = t('noResults');
          tr.append(td);
          body.append(tr);
          return;
        }
        rows.forEach((row) => {
          const point = row.point;
          const tr = document.createElement('tr');
          tr.append(
            makeCell(point.model), makeCell(point.agent), makeCell(point.effort),
            makeCell(formatScore(point.score), 'numeric'),
            makeCell(formatUSD(point.apiCost), 'numeric money'),
            makeCell(formatUSD(row.cost), 'numeric money'),
            makeCell(basisText(row), 'basis')
          );
          body.append(tr);
        });
      }
      function escapeHTML(value) {
        return text(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
      }
      function tooltipHTML(row) {
        const point = row.point;
        const basis = basisText(row);
        const line = (label, value) => `<div class="tip-row"><span class="tip-label">${escapeHTML(label)}</span><span>${escapeHTML(value)}</span></div>`;
        return `<div class="tip-title">${escapeHTML(point.model)}</div>${line(t('agentColumn'), point.agent)}${line(t('effortColumn'), point.effort)}${line(t('scoreHeader'), formatScore(point.score))}${line(t('apiUsdColumn'), formatUSD(point.apiCost))}${line(t('displayUsdColumn'), formatUSD(row.cost))}${line(t('costBasisColumn'), basis)}`;
      }
      function renderChart() {
        const benchmark = activeBenchmark();
        const visibleRows = rowsForBenchmark();
        const chartableRows = visibleRows.filter((row) => axisScale === 'log' ? row.cost > 0 : row.cost >= 0);
        const excluded = visibleRows.length - chartableRows.length;
        const exclusionLabel = axisScale === 'log' ? t('zeroOnLog', excluded) : t('negativeOnLinear', excluded);
        $('chart-count').textContent = t('chartCount', visibleRows.length, excluded ? exclusionLabel : '');
        $('chart-note').textContent = excluded ? axisScale === 'log' ? t('zeroLogNote') : t('negativeLinearNote') : '';
        const empty = $('chart-empty');
        empty.hidden = chartableRows.length > 0;
        if (!benchmark || !benchmark.points || !benchmark.points.length) {
          empty.textContent = t('noChartBenchmark');
        } else if (!visibleRows.length) {
          empty.textContent = t('selectModel');
        } else if (!chartableRows.length && axisScale === 'log') {
          empty.textContent = t('noPositiveCost');
        } else {
          empty.textContent = t('noChartResults');
        }
        if (!window.echarts) {
          $('chart-failure').hidden = false;
          return;
        }
        $('chart-failure').hidden = true;
        if (!chart) chart = window.echarts.init($('chart'), null, { renderer: 'canvas' });
        chart.clear();
        if (!chartableRows.length) return;

        const groups = new Map();
        chartableRows.forEach((row) => {
          const key = `${text(row.point.model)}\u0000${text(row.point.agent)}`;
          if (!groups.has(key)) groups.set(key, []);
          groups.get(key).push(row);
        });
        for (const group of groups.values()) group.sort(compareEffortRows);
        const curveGroups = [...groups.values()];
        const labeledGroups = new Set();
        if (!narrowPlot) {
          curveGroups
            .map((group, index) => ({ index, score: Number(group[group.length - 1].point.score), model: text(group[0].point.model), agent: text(group[0].point.agent) }))
            .sort((a, b) => b.score - a.score || a.model.localeCompare(b.model) || a.agent.localeCompare(b.agent))
            .slice(0, 8)
            .forEach(({ index }) => labeledGroups.add(index));
        }
        const colors = new Map();
        const series = curveGroups.map((group, index) => {
          const model = text(group[0].point.model);
          const color = colors.get(model) || modelColor(model, benchmark.points);
          colors.set(model, color);
          const last = group.length - 1;
          return {
            id: `curve-${index}`,
            name: `${model} / ${text(group[0].point.agent)}`,
            type: 'line',
            showSymbol: true,
            symbol: 'circle',
            symbolSize: 8,
            connectNulls: false,
            lineStyle: { color, width: 1.6, opacity: 0.78 },
            itemStyle: { color },
            emphasis: { focus: 'series', scale: true, lineStyle: { width: 2.5 } },
            label: { show: false },
            labelLayout: { hideOverlap: true, moveOverlap: 'shiftY' },
            data: group.map((row, pointIndex) => ({
              value: [row.cost, Number(row.point.score)],
              point: row.point,
              row,
              endLabel: `${text(row.point.model)} / ${text(row.point.effort)}`,
              label: { show: labeledGroups.has(index) && pointIndex === last, position: 'left', align: 'right', distance: 4, color, fontSize: narrowPlot ? 10 : 11, formatter: (params) => params.data.endLabel },
              itemStyle: row.fallback ? { color: '#ffffff', borderColor: color, borderWidth: 2.3 } : { color, borderColor: color, borderWidth: 1 }
            }))
          };
        });
        chart.setOption({
          animation: false,
          aria: { enabled: true, description: t('chartDescription', benchmark.title || benchmark.id || t('benchmarkLabel')) },
          grid: { left: narrowPlot ? 44 : 72, right: narrowPlot ? 12 : 28, top: narrowPlot ? 29 : 37, bottom: narrowPlot ? 54 : 67, containLabel: true },
          tooltip: {
            trigger: 'item',
            renderMode: 'html',
            confine: true,
            backgroundColor: '#ffffff',
            borderColor: '#b9c7d8',
            borderWidth: 1,
            textStyle: { color: '#202e46', fontFamily: 'Avenir Next, Trebuchet MS, system-ui, sans-serif', fontSize: 12 },
            formatter: (params) => {
              const item = Array.isArray(params) ? params[0] : params;
              return item && item.data && item.data.row ? tooltipHTML(item.data.row) : '';
            }
          },
          xAxis: {
            type: axisScale === 'log' ? 'log' : 'value',
            min: axisScale === 'linear' ? 0 : undefined,
            name: t('displayCostAxis'),
            nameLocation: 'middle',
            nameGap: narrowPlot ? 30 : 42,
            axisLabel: { color: '#556783', formatter: formatAxisUSD, hideOverlap: true, fontSize: narrowPlot ? 10 : 12 },
            axisLine: { lineStyle: { color: '#9eacc0' } },
            splitLine: { lineStyle: { color: '#e5ebf2' } }
          },
          yAxis: {
            type: 'value',
            name: benchmark.scoreLabel || t('scoreHeader'),
            nameLocation: 'middle',
            nameGap: narrowPlot ? 34 : 52,
            axisLabel: { color: '#556783', hideOverlap: true, fontSize: narrowPlot ? 10 : 12 },
            axisLine: { lineStyle: { color: '#9eacc0' } },
            splitLine: { lineStyle: { color: '#e5ebf2' } }
          },
          dataZoom: [{ type: 'inside', xAxisIndex: 0, filterMode: 'none' }],
          series
        }, true);
      }
      function renderViews() {
        renderTable();
        renderChart();
      }
      benchmarkSelect.addEventListener('change', () => {
        renderDefinitions();
        renderModelLegend();
        renderViews();
      });
      document.querySelectorAll('input[name="cost-mode"]').forEach((input) => input.addEventListener('change', () => {
        if (input.checked) {
          mode = input.value;
          renderSubscriptionPanel();
          renderModelLegend();
          renderViews();
        }
      }));
      document.querySelectorAll('input[name="axis-scale"]').forEach((input) => input.addEventListener('change', () => {
        if (input.checked) {
          axisScale = input.value;
          renderChart();
        }
      }));
      initBenchmarks();
      renderDates();
      renderSubscriptionPanel();
      renderDefinitions();
      renderSources();
      renderModelLegend();
      renderViews();
      window.addEventListener('resize', () => {
        if (chart) chart.resize();
        const nextNarrowPlot = window.matchMedia('(max-width: 600px)').matches;
        if (nextNarrowPlot !== narrowPlot) {
          narrowPlot = nextNarrowPlot;
          renderChart();
        }
      });
    })();
  </script>
</body>
</html>
