        benchmarkSelect.value = benchmarks.length ? '0' : '';
      }
      function restoreURLState() {
        const params = new URLSearchParams(window.location.search);
        mode = params.get('cost-mode') === 'api' ? 'api' : 'subscription';
        costBasis = params.get('cost-basis') === 'rollout' ? 'rollout' : 'unit';
        axisScale = params.get('axis-scale') === 'linear' ? 'linear' : 'log';
